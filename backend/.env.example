# =================================================================
# Backend Environment Configuration Example
# =================================================================
# Copy this file to .env and fill in your real credentials:
# cp .env.example .env
#
# NOTE: Never commit your real .env file with production secrets!
# Set these variables in your deployment dashboard (e.g. Render, Railway, etc.)
# =================================================================

# Database Configuration
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.84utnyq.mongodb.net/
DB_NAME=wavygo_db

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGINS=*
PORT=8000

# Founder Account Configuration
FOUNDER_EMAIL=anil@wavygo.in
FOUNDER_PASSWORD=your_founder_password_here
FOUNDER_NAME=Anil Anand

# Brevo Email Service Configuration
# API key obtained from Brevo Dashboard (SMTP & API -> API Keys)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=garv.agarwal2409@gmail.com
BREVO_SENDER_NAME=WavyGo OS

# Frontend URL (Used for email invitation and reset password links)
FRONTEND_URL=https://app-eta-flax-97.vercel.app

# Calendar reminders: seconds between checks for due reminders (default 60)
# CALENDAR_REMINDER_INTERVAL_SECONDS=60

# WavyGo AI (Claude API). Without a key the AI page shows a setup message.
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-opus-5
